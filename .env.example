# Copy to .env and fill in the values for the environment you are working against.
# Everything prefixed with VITE_ is bundled into the client and is therefore
# public: never put a service role key or any secret here.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (publishable) key. Safe to ship to the browser.
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key for the Payment Element (test: pk_test_…).
VITE_STRIPE_PUBLISHABLE_KEY=


# ---------------------------------------------------------------------------
# Edge function secrets — set with `supabase secrets set`, never in this file
# and never committed:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   RESEND_API_KEY
#   ADMIN_FUNCTION_SECRET      # x-admin-secret for admin-cancel-booking
#   PAYOUT_CRON_SECRET         # x-cron-secret for release-payout
#   SITE_URL                   # e.g. https://trykai.sg, used for Connect return URLs
#
# Platform Stripe payouts must be set to manual (or a reserve covering
# outstanding host Transfers). Auto-payout to Aspire would drain the platform
# balance before the 24h host Transfer.
#
# Neither the unit suite nor the end-to-end suite needs any of the above: the
# Supabase client is mocked in unit tests and stubbed at the network layer in
# end-to-end tests.
